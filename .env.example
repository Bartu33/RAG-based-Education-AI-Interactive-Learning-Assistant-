# Copy to .env and fill in what you use. .env is git-ignored.
GROQ_API_KEY=
OPENAI_API_KEY=
# groq | openai | ollama (privacy mode: nothing leaves the machine). Overrides llm.provider in config.yaml.
LLM_PROVIDER=
# Only needed for gated Hugging Face models / higher download rate limits.
HF_TOKEN=
# Where the Streamlit UI finds the backend.
RAG_API_URL=http://localhost:8000
